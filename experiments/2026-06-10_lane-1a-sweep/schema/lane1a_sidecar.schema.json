{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lane-1a-sidecar.schema.json",
  "title": "Lane 1a sidecar attestation",
  "description": "Per-invocation companion to a B1 v2 output file. B1 output bytes are preserved unchanged; Lane 1a metadata lives in this sidecar. The sidecar records the B1 output sha256 so an auditor can verify byte-for-byte preservation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "b1_output_path",
    "b1_output_sha256",
    "b1_context_argument_passed",
    "b1_framework_version_argument_passed",
    "wrapper_attestation",
    "rung_id",
    "stratum",
    "attempt_id",
    "wrapper_invocation_ts"
  ],
  "properties": {
    "schema": { "const": "lane-1a-sidecar.schema.json" },
    "b1_output_path": { "type": "string" },
    "b1_output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "b1_context_argument_passed": { "const": "paper2-reproduction" },
    "b1_framework_version_argument_passed": { "const": "none" },
    "wrapper_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "certification_relevance",
        "lane_1a_context",
        "context_is_wrapper_asserted_not_runner_attested",
        "context_functional_statement"
      ],
      "properties": {
        "artifact_class": { "const": "lane-1a-reconnaissance" },
        "certification_relevance": { "const": "none" },
        "lane_1a_context": { "const": "lane-1a-reconnaissance" },
        "context_is_wrapper_asserted_not_runner_attested": { "const": true },
        "context_functional_statement": { "type": "string", "minLength": 200 }
      }
    },
    "rung_id": { "enum": ["L01","L02","L03","L04","L05","L06","L07","L08"] },
    "stratum": { "enum": ["answerable","null","answerable_mirror","null_mirror"] },
    "attempt_id": { "type": "integer", "minimum": 1 },
    "wrapper_invocation_ts": { "type": "string", "format": "date-time" }
  }
}
